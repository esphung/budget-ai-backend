{
	"compilerOptions": {
		"target": "ES2022",
		"module": "nodenext",
		"lib": ["ES2022"],
		"outDir": "dist",
		"rootDir": "src",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,
		"moduleResolution": "nodenext",
		"types": ["jest", "node"],
		"noImplicitAny": false
	},
	"include": ["src", "index.ts"],
	"exclude": ["node_modules", "dist", "coverage"]
}
