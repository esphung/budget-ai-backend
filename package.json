{
	"name": "budget-ai-backend",
	"version": "0.0.1",
	"versionCode": 1,
	"description": "Local Node.js backend for BudgetAI POC",
	"private": true,
	"main": "dist/index.js",
	"scripts": {
		"dev": "npx nodemon --watch 'src/**/*.ts' --exec 'npx ts-node' src/index.ts",
		"build": "npx tsc --project tsconfig.json",
		"heroku-postbuild": "yarn build",
		"start": "node dist/index.js",
		"ts:start": "npx ts-node src/index.ts",
		"test": "npx jest",
		"test:coverage": "npx jest --coverage",
		"clean": "rm -rf dist coverage node_modules",
		"lint": "npx eslint src/**/*.ts",
		"lint:fix": "npx eslint src/**/*.ts --fix",
		"typecheck": "npx tsc --noEmit --project tsconfig.json",
		"postinstall": "npx tsc --project tsconfig.json",
		"format": "npx prettier --write 'src/**/*.ts'",
		"format:check": "npx prettier --check 'src/**/*.ts'",
		"precommit": "yarn lint:fix && yarn typecheck && yarn test"
	},
	"dependencies": {
		"axios": "^1.15.2",
		"cors": "^2.8.5",
		"dotenv": "^17.4.2",
		"express": "^4.19.2",
		"morgan": "^1.10.1",
		"plaid": "^42.1.0",
		"tslog": "^4.10.2",
		"typescript": "^6.0.3"
	},
	"devDependencies": {
		"@jest/globals": "^30.3.0",
		"@types/cors": "^2.8.17",
		"@types/express": "^4.17.21",
		"@types/jest": "^30.0.0",
		"@types/morgan": "^1",
		"@types/node": "^20.14.0",
		"@types/supertest": "^7",
		"eslint": "^10.2.1",
		"nodemon": "^3.1.14",
		"supertest": "^7.2.2",
		"ts-jest": "^29.4.9",
		"ts-node-dev": "^2.0.0",
		"typescript-eslint": "^8.59.1"
	},
	"packageManager": "yarn@4.14.1"
}
